# ==============================================================================
# KlerkOne TradePilot — Environment Configuration Template
# Copy this file to '.env' in both root and backend directory as appropriate.
# NEVER commit your actual '.env' file containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
HOST=localhost
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. SUPABASE (POSTGRESQL) DATABASE
# ------------------------------------------------------------------------------
# Create a free project at https://supabase.com
# Find these in Project Settings -> API
# Leave blank to use TradePilot's built-in high-fidelity in-memory repository
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 3. FYERS API v3 CREDENTIALS
# ------------------------------------------------------------------------------
# Generate your App in FYERS API Dashboard: https://myapi.fyers.in/dashboard
# APP_ID format usually looks like: "XC12345-100"
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=http://localhost:5000/api/v1/broker/fyers/callback
FYERS_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 4. TRADING CORE CONTROLS & SAFETY LIMITS
# ------------------------------------------------------------------------------
# Default mode on startup: BACKTEST | PAPER | LIVE
# SAFETY RULE: Live mode is disabled by default and requires explicit manual activation.
DEFAULT_TRADING_MODE=PAPER

# Initial capital allocation allocated to TradePilot (in INR ₹)
DEFAULT_ALLOCATED_CAPITAL=50000

# Maximum risk per single trade as a % of allocated capital (e.g., 0.5 = 0.5%)
RISK_PER_TRADE_PERCENT=0.5

# Maximum permitted daily loss before all new entries are frozen (e.g., 1.5 = 1.5%)
DAILY_LOSS_LIMIT_PERCENT=1.5

# Maximum number of simultaneously open positions (default: 3)
MAX_OPEN_POSITIONS=3

# Maximum % of allocated capital that can be deployed across all open positions (default: 50%)
MAX_CAPITAL_UTILISATION_PERCENT=50.0

# ------------------------------------------------------------------------------
# 5. SECURITY & ACCESS RESTRICTIONS
# ------------------------------------------------------------------------------
DASHBOARD_AUTH_SECRET=change-this-to-a-very-secure-random-string-in-production
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=120

# ------------------------------------------------------------------------------
# 6. OPTIONAL AI MARKET INTELLIGENCE
# ------------------------------------------------------------------------------
OPTIONAL_AI_PROVIDER=mock
OPTIONAL_AI_API_KEY=
OPTIONAL_AI_MODEL=gpt-4o-mini
